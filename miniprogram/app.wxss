page {
  --brand: #0a84ff;
  --brand-dark: #0060df;
  --bg: #f4f6f9;
  --card: #ffffff;
  --text: #1b1d21;
  --sub: #6b7280;
  --line: #e8eaed;
  --warn: #ff9500;
  --danger: #ff3b30;
  --ok: #34c759;

  background: var(--bg);
  color: var(--text);
  font-size: 30rpx;
  line-height: 1.6;
}

.page {
  padding: 24rpx 24rpx 60rpx;
}

.card {
  background: var(--card);
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(16, 24, 40, 0.05);
}

.card-title {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.card-sub {
  font-size: 26rpx;
  color: var(--sub);
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin: 8rpx 0 16rpx;
}

.label {
  font-size: 30rpx;
  font-weight: 600;
}

.hint {
  font-size: 26rpx;
  color: var(--sub);
}

.mono-num {
  font-variant-numeric: tabular-nums;
}

/* 按钮 */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  border-radius: 20rpx;
  font-size: 32rpx;
  font-weight: 600;
  box-sizing: border-box;
}

.btn-primary {
  background: var(--brand);
  color: #ffffff;
}

.btn-primary.btn-disabled {
  background: #c7cbd1;
  color: #ffffff;
}

.btn-ghost {
  background: #ffffff;
  color: var(--brand);
  border: 2rpx solid var(--brand);
}

.btn-block {
  width: 100%;
}

/* 标签 */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  background: #eef4ff;
  color: var(--brand);
  margin-right: 12rpx;
}

.tag-level {
  background: #f1f3f5;
  color: var(--sub);
}

.tag-warn {
  background: #fff4e5;
  color: #b26a00;
}

.tag-danger {
  background: #ffeceb;
  color: var(--danger);
}

/* 提示条 */
.tip {
  background: #eef4ff;
  border-left: 6rpx solid var(--brand);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
  color: #24508a;
  margin-bottom: 20rpx;
}

.tip-warn {
  background: #fff4e5;
  border-left-color: var(--warn);
  color: #8a5300;
}

.tip-danger {
  background: #ffeceb;
  border-left-color: var(--danger);
  color: #a3241f;
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 120rpx 40rpx;
  color: var(--sub);
  font-size: 28rpx;
}

.empty-title {
  font-size: 32rpx;
  color: var(--text);
  margin-bottom: 12rpx;
  font-weight: 600;
}

.divider {
  height: 2rpx;
  background: var(--line);
  margin: 20rpx 0;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
