<view class="page">
  <view wx:if="{{reminderTip}}" class="tip">{{reminderTip}}</view>

  <view class="card">
    <view class="row-between">
      <view>
        <view class="card-title">我的锻炼记录</view>
        <view class="card-sub">共 {{totalCount}} 次 · 累计 {{totalMin}} 分钟</view>
      </view>
      <view class="add-btn" bindtap="onGoEntry">＋ 记一次</view>
    </view>
  </view>

  <view wx:if="{{records.length === 0}}" class="empty">
    <view class="empty-title">还没有锻炼记录</view>
    <view>点右上角「＋ 记一次」，把今天练的内容和身体感受记下来。</view>
  </view>

  <block wx:if="{{records.length > 0}}">
    <view class="card">
      <view class="card-title">身体感受变化趋势</view>
      <view class="card-sub">最近 {{records.length > 12 ? 12 : records.length}} 次记录的身体感受评分</view>
      <canvas type="2d" id="painChart" class="chart"></canvas>
      <view class="legend">
        <view class="legend-item">
          <view class="legend-line"></view>
          <text>身体感受评分（0-10）</text>
        </view>
      </view>
    </view>

    <view class="list-title">历史记录</view>
    <view wx:for="{{records}}" wx:key="id" class="card rec-card">
      <view class="row-between">
        <view class="rec-date">{{item.dateText}}</view>
        <view class="rec-right">
          <text class="rec-duration mono-num">{{item.durationText}}</text>
          <text class="rec-del" data-id="{{item.id}}" bindtap="onDeleteRecord">删除</text>
        </view>
      </view>

      <view class="rec-nums">
        <view class="rec-num">
          <text class="rec-num-value mono-num">{{item.feelingScore}}</text>
          <text class="rec-num-label">身体感受</text>
        </view>
      </view>

      <view class="rec-exs">
        <text wx:for="{{item.exerciseTexts}}" wx:for-item="t" wx:key="*this" class="rec-ex">{{t}}</text>
      </view>

      <view wx:if="{{item.note}}" class="rec-note">备注：{{item.note}}</view>
    </view>
  </block>
</view>
