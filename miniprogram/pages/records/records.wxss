.add-btn {
  background: var(--brand);
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 600;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
}

.chart {
  width: 100%;
  height: 380rpx;
  margin-top: 12rpx;
}

.legend {
  display: flex;
  margin-top: 12rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: var(--sub);
}

.legend-line {
  width: 32rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: #0a84ff;
  margin-right: 8rpx;
}

.list-title {
  font-size: 30rpx;
  font-weight: 600;
  margin: 16rpx 8rpx 12rpx;
}

.rec-card {
  padding: 24rpx 28rpx;
}

.rec-date {
  font-size: 30rpx;
  font-weight: 600;
}

.rec-right {
  display: flex;
  align-items: center;
}

.rec-duration {
  font-size: 26rpx;
  color: var(--sub);
}

.rec-del {
  font-size: 26rpx;
  color: var(--danger);
  margin-left: 20rpx;
}

.rec-nums {
  display: flex;
  margin-top: 14rpx;
}

.rec-num {
  display: flex;
  flex-direction: column;
  margin-right: 40rpx;
}

.rec-num-value {
  font-size: 34rpx;
  font-weight: 600;
}

.rec-num-label {
  font-size: 23rpx;
  color: var(--sub);
}

.rec-exs {
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 2rpx solid var(--line);
}

.rec-ex {
  display: inline-block;
  font-size: 25rpx;
  color: #33383f;
  background: #f4f6f9;
  border-radius: 8rpx;
  padding: 8rpx 14rpx;
  margin: 0 10rpx 10rpx 0;
}

.rec-note {
  font-size: 25rpx;
  color: var(--sub);
}
