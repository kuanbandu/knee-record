.input-wrap {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  border-bottom: 2rpx solid var(--line);
  padding-bottom: 12rpx;
}

.age-input {
  flex: 1;
  font-size: 36rpx;
}

.option-list {
  margin-top: 20rpx;
}

.option {
  border: 2rpx solid var(--line);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
}

.option-active {
  border-color: var(--brand);
  background: #f5f9ff;
}

.option-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.option-title {
  font-size: 32rpx;
  font-weight: 600;
}

.option-desc {
  font-size: 25rpx;
  color: var(--sub);
  margin-top: 4rpx;
}

.radio {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 3rpx solid #cfd4da;
  box-sizing: border-box;
}

.radio-on {
  border-color: var(--brand);
  border-width: 10rpx;
  background: #ffffff;
}

.bend-value {
  font-size: 56rpx;
  font-weight: 700;
  color: var(--brand);
  margin-top: 8rpx;
}

.scale-row {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: var(--sub);
  margin-top: -6rpx;
}

.save-btn {
  margin-top: 12rpx;
}

.foot-note {
  text-align: center;
  font-size: 24rpx;
  color: var(--sub);
  padding: 20rpx 40rpx 20rpx;
}
