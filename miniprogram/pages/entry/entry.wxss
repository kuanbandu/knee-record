.ex-row {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}

.ex-name-input {
  flex: 1;
  border-bottom: 2rpx solid var(--line);
  padding: 12rpx 0;
  font-size: 30rpx;
}

.ex-sets-input {
  width: 130rpx;
  margin-left: 16rpx;
  border-bottom: 2rpx solid var(--line);
  padding: 12rpx 0;
  text-align: center;
  font-size: 30rpx;
}

.ex-del {
  width: 56rpx;
  text-align: center;
  font-size: 40rpx;
  color: var(--danger);
  margin-left: 12rpx;
}

.ex-del.disabled {
  color: #d8dce1;
}

.add-row {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: var(--brand);
}

.feeling-value {
  font-size: 56rpx;
  font-weight: 700;
  margin-top: 8rpx;
}

.scale-row {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: var(--sub);
  margin-top: -6rpx;
}

.input-wrap {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  border-bottom: 2rpx solid var(--line);
  padding-bottom: 12rpx;
}

.input-wrap input {
  flex: 1;
  font-size: 32rpx;
}

.unit {
  color: var(--sub);
  margin-left: 8rpx;
}

.note {
  width: 100%;
  height: 140rpx;
  margin-top: 16rpx;
  font-size: 29rpx;
  box-sizing: border-box;
}

.save-btn {
  margin-top: 20rpx;
}
